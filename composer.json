{
    "name": "silverstripe/laboratory",
    "description": "Content experimentation module for Silverstripe CMS",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "A/B testing",
        "experimentation",
        "content variations"
    ],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Silverstripe",
            "homepage": "https://silverstripe.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6",
        "silverstripe/cms": "^6",
        "silverstripe/admin": "^3",
        "silverstripe/versioned": "^3"
    },
    "require-dev": {
        "dnadesign/silverstripe-elemental": "^6",
        "silverstripe/documentation-lint": "^1",
        "silverstripe/recipe-testing": "^4",
        "silverstripe/frameworktest": "^2",
        "silverstripe/standards": "^1",
        "phpstan/extension-installer": "^1.3"
    },
    "suggest": {
        "dnadesign/silverstripe-elemental": "For better CMS content managment experience"
    },
    "autoload": {
        "psr-4": {
            "SilverStripe\\Laboratory\\": "src/",
            "SilverStripe\\Laboratory\\Tests\\": "tests/php/"
        }
    },
    "scripts": {
        "lint": "phpcs src/ tests/php/",
        "lint-clean": "phpcbf src/ tests/php/"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.x-dev",
            "dev-0": "0.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
