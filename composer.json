{
    "name": "silverstripe/laboratory",
    "description": "Content experimentation module for Silverstripe CMS",
    "type": "silverstripe-vendormodule",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Silverstripe",
            "homepage": "https://silverstripe.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^5.3",
        "silverstripe/cms": "^5",
        "silverstripe/versioned": "^2",
        "silverstripe/admin": "^2.2"
    },
    "require-dev": {
        "silverstripe/frameworktest": "^1",
        "dnadesign/silverstripe-elemental": "^5",
        "silverstripe/documentation-lint": "^1",
        "phpunit/phpunit": "^9.5",
        "silverstripe/behat-extension": "^5.4",
        "silverstripeltd/bespoke-standards": "^1.2"
    },
    "suggest": {
        "dnadesign/silverstripe-elemental": "For better CMS content managment experience"
    },
    "autoload": {
        "psr-4": {
            "SilverStripe\\Laboratory\\": "src/",
            "SilverStripe\\Laboratory\\Tests\\": "tests/php/"
        }
    },
    "scripts": {
        "lint": "phpcs src/ tests/php/",
        "lint-clean": "phpcbf src/ tests/php/"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.x-dev",
            "dev-0": "0.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
